   "source": [
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Style\n",
    "sns.set(style=\"whitegrid\")\n",
    "\n",
    "plt.figure(figsize=(14, 10))\n",
    "\n",
    "# 1. GHI vs Temperature\n",
    "plt.subplot(2, 2, 1)\n",
    "hb1 = plt.hexbin(\n",
    "    df_clean['GHI'],\n",
    "    df_clean['Tamb'],\n",
    "    gridsize=40,\n",
    "    cmap='coolwarm',\n",
    "    mincnt=1\n",
    ")\n",
    "plt.colorbar(hb1, label='Density')\n",
    "plt.xlabel('GHI')\n",
    "plt.ylabel('Ambient Temperature')\n",
    "plt.title('GHI vs Ambient Temperature')\n",
    "\n",
    "# 2. GHI vs Humidity\n",
    "plt.subplot(2, 2, 2)\n",
    "hb2 = plt.hexbin(\n",
    "    df_clean['GHI'],\n",
    "    df_clean['RH'],\n",
    "    gridsize=40,\n",
    "    cmap='viridis',\n",
    "    mincnt=1\n",
    ")\n",
    "plt.colorbar(hb2, label='Density')\n",
    "plt.xlabel('GHI')\n",
    "plt.ylabel('Relative Humidity')\n",
    "plt.title('GHI vs Relative Humidity')\n",
    "\n",
    "# 3. Temperature vs Humidity\n",
    "plt.subplot(2, 2, 3)\n",
    "hb3 = plt.hexbin(\n",
    "    df_clean['Tamb'],\n",
    "    df_clean['RH'],\n",
    "    gridsize=40,\n",
    "    cmap='plasma',\n",
    "    mincnt=1\n",
    ")\n",
    "plt.colorbar(hb3, label='Density')\n",
    "plt.xlabel('Ambient Temperature')\n",
    "plt.ylabel('Relative Humidity')\n",
    "plt.title('Temperature vs Humidity')\n",
    "\n",
    "# 4. Wind Speed vs GHI\n",
    "plt.subplot(2, 2, 4)\n",
    "hb4 = plt.hexbin(\n",
    "    df_clean['WS'],\n",
    "    df_clean['GHI'],\n",
    "    gridsize=40,\n",
    "    cmap='magma',\n",
    "    mincnt=1\n",
    ")\n",
    "plt.colorbar(hb4, label='Density')\n",
    "plt.xlabel('Wind Speed')\n",
    "plt.ylabel('GHI')\n",
    "plt.title('Wind Speed vs GHI')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
